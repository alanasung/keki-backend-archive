# Reference list of every environment variable this repository reads,
# gathered from packages/database/src/env.ts, packages/auth/src/env.ts,
# apps/web, and functions/*. See docs/environment.md for the full table
# (required/optional, which surface consumes it, how to obtain a real value)
# and README.md "Environment setup" for how to load this file into your
# shell.
#
# Copy this file to `.env` (gitignored) and fill in real values:
#   cp .env.example .env
#
# `.env` is not read automatically by every tool in this repo (Next.js reads
# its own .env.local, drizzle-kit's dotenv/config reads relative to its own
# package directory) — load it into your shell before running any command
# that needs it:
#   set -a && source .env && set +a
#
# Do not commit real credentials to this file or to `.env`.

# --- packages/database (all application and migration traffic) ----------

# Neon pooled connection string. Host MUST contain "-pooler". Used by the
# Next.js app and every Lambda worker at runtime. Obtain from the Neon
# project dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL_POOLED=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/keki?sslmode=require

# Neon direct connection string. Host MUST NOT contain "-pooler". Used only
# by `pnpm db:migrate` / drizzle-kit. Obtain from the Neon project dashboard
# -> Connection Details -> "Direct connection".
#
# DATABASE_URL_POOLED and DATABASE_URL_DIRECT are not interchangeable. If
# they are swapped, the app refuses to start — see docs/environment.md
# "Pooled vs. direct" for the exact error message.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/keki?sslmode=require

# --- packages/auth (web app) ----------------------------------------------

# Cognito User Pool ID. Obtain from the AWS Cognito console, or from
# `sst dev`/`sst deploy` output once WS-10's infra is provisioned.
COGNITO_USER_POOL_ID=us-east-1_example

# Cognito App Client ID (the client apps/web authenticates against).
COGNITO_CLIENT_ID=example-client-id

# AWS region the Cognito User Pool lives in.
AWS_REGION=us-east-1

# --- packages/auth (test stages only) -------------------------------------

# Overrides the derived Cognito issuer URL. Used only by the Playwright e2e
# suite to point verification at a locally served JWKS (see docs/testing.md).
# The app refuses to start with this set when NODE_ENV=production.
# COGNITO_ISSUER=https://localhost:3001

# Overrides the derived Cognito JWKS URI. Same test-only restriction as
# COGNITO_ISSUER above.
# COGNITO_JWKS_URI=https://localhost:3001/.well-known/jwks.json

# --- apps/web ---------------------------------------------------------------

# Shared static token that identifies on-site kiosk hardware (device
# session, not a user session — see apps/web/app/auth/guards.ts). Choose any
# random string for local development; a real deployment provisions this via
# the KioskDeviceToken SST secret.
KIOSK_DEVICE_TOKEN=example-kiosk-device-token

# --- functions/square-webhook (function environment, not the web app) -----

# Verifies inbound Square webhook signatures. Obtain from the Square
# Developer Dashboard -> your application -> Webhooks -> Signature Key. In a
# deployed stage this is supplied by the SquareWebhookSignatureKey SST
# secret, not by this file.
SQUARE_WEBHOOK_SIGNATURE_KEY=example-square-webhook-signature-key

# --- functions/notification-worker (non-production stages only) -----------

# Allows the notification worker to fall back to no-op provider
# implementations (no real email/SMS/marketing send). Set by SST
# automatically on every non-production stage; only set it here if you are
# running the worker's code directly outside SST. Must never be "true" in
# production — see packages/notification-core/src/providers.ts.
# KEKI_ALLOW_NOOP_PROVIDERS=true
