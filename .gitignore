# Build-runner output. The program-pipeline runner explicitly `git add`s
# `build-logs` during its per-workstream commit, and git refuses to stage an
# explicitly-named path that is wholly ignored — which silently turned every
# workstream commit into a no-op. So track the runner's own structured
# artifacts and keep everything else here (local scratch scripts, deploy and
# supervisor logs) out of version control.
build-logs/*
!build-logs/*.jsonl
!build-logs/*-baselines.json

# Dependencies
node_modules/

# Next.js
.next/

# SST / OpenNext
.sst/
.open-next/

# Build artifacts
dist/
*.tsbuildinfo
next-env.d.ts

# Env
.env
.env.local

# Test artifacts
coverage/
playwright-report/
test-results/
vitest-report.json

# Generated once per machine by apps/web/e2e/fixtures/jwks-server.ts: the
# RSA signing key and the self-signed TLS certificate/key the local JWKS
# server uses. Must stay out of version control (private key material) and
# must stay stable across a single run (signer and server have to agree).
apps/web/e2e/.e2e-keys/

# Local agent settings (personal, not shared)
.claude/settings.local.json
