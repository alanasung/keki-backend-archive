node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true

# Cap how many workspace packages run a script at once. Unbounded, `pnpm -r test`
# starts a Vitest instance per package and each spawns its own worker pool —
# ~150 workers on a 10-core machine. That contention, not any real work, made
# the suite take ~14 minutes; capped at 4 it finishes in under 10 seconds.
workspace-concurrency=4
