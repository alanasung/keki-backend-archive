# Template for apps/web/.env.development and apps/web/.env.production.
# Copy to the one you need and fill in real values — neither is tracked.
#
# Next.js loads .env.development for `next dev` and .env.production for
# `next build`. CI sets NODE_ENV=test, so it loads neither and supplies these
# through the workflow's own env block instead (see .github/workflows/ci.yml).

DATABASE_URL_POOLED=postgresql://user:password@ep-example-pooler.us-west-2.aws.neon.tech/neondb
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.us-west-2.aws.neon.tech/neondb

AWS_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_exampleId
COGNITO_CLIENT_ID=example-client-id

# phase-5-customer-onboarding. The redirect URI must match a callback URL
# registered on the Cognito client exactly, including scheme and trailing
# slash; Cognito permits http only for localhost.
COGNITO_HOSTED_UI_URL=https://keki-dev.auth.us-west-2.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
COGNITO_SIGN_OUT_URI=http://localhost:3000/auth/sign-out/complete
