{
  "name": "keki-backend-prod",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "postinstall": "sst install",
    "sst:dev": "sst dev",
    "deploy": "sst deploy",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @keki/database db:migrate",
    "publish-sample-message": "tsx scripts/publish-sample-message.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@keki/contracts": "workspace:*",
    "@keki/database": "workspace:*",
    "@keki/notification-core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "eslint": "^9.19.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "sst": "^3.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.2.7"
  }
}
