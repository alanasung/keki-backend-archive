{
  "schemaVersion": 1,
  "pipelineVersion": "0.3.2",
  "visionPath": "docs/vision.md",
  "requireApprovalBeforeBuild": true,
  "agent": { "command": "claude", "args": ["-p", "--model", "sonnet"] },
  "validatorAgent": { "command": "codex", "args": ["exec", "--model", "gpt-sol"] },
  "models": {
    "author": "claude-code/opus",
