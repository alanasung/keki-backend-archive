    "validator": "gpt-5.6-terra"
  },
  "verify": {
    "workspace": "test -f pnpm-workspace.yaml && test -f package.json",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "contextDocs": ["docs/vision.md"]
}
