{
  "schemaVersion": 1,
  "pipelineVersion": "0.8.0",
  "visionPath": "docs/vision.md",
  "requireApprovalBeforeBuild": true,
  "agent": {
    "command": "claude",
    "args": [
      "-p",
      "--model",
      "sonnet",
      "--dangerously-skip-permissions"
    ]
  },
  "validatorAgent": {
    "command": "codex",
    "args": [
      "exec",
      "--model",
      "gpt-5.6-terra"
    ]
  },
  "models": {
    "author": "claude-code/opus",
    "validator": "gpt-5.6-terra"
  },
  "build": {
    "critiqueTests": true
  },
  "verify": {
    "workspace": "test -f pnpm-workspace.yaml && test -f package.json",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "test": "pnpm test:isolated-audit"
  },
  "contextDocs": [
    "docs/vision.md",
    "docs/as-built.md",
    "docs/architecture.md",
    "docs/environment.md",
    "docs/testing.md"
  ]
}
