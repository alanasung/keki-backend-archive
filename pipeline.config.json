{
  "schemaVersion": 1,
  "pipelineVersion": "0.3.2",
  "visionPath": "docs/vision.md",
  "requireApprovalBeforeBuild": true,
  "agent": {
    "command": "claude",
    "args": ["-p", "--model", "sonnet", "--dangerously-skip-permissions"]
  },
  "validatorAgent": { "command": "codex", "args": ["exec", "--model", "gpt-5.6-terra"] },
  "models": {
